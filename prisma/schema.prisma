generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String     @id @default(cuid())
  name                   String
  email                  String     @unique
  passwordHash           String?    @default("")
  role                   UserRole   @default(INTERNAL_STAFF)
  status                 UserStatus @default(ACTIVE)
  avatarUrl              String?
  assignedCustomersCount Int        @default(0)
  lastActive             DateTime?
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt
  customerId             String?
  Customer               Customer?  @relation(fields: [customerId], references: [id])

  @@index([createdAt])
  @@index([customerId])
  @@index([role])
  @@index([status])
}

model Customer {
  id                 String         @id @default(cuid())
  name               String
  company            String
  email              String         @unique
  phone              String
  billingAddress     String
  taxId              String?
  notes              String?
  status             CustomerStatus @default(ACTIVE)
  totalSpent         Decimal        @default(0) @db.Decimal(12, 2)
  outstandingBalance Decimal        @default(0) @db.Decimal(12, 2)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  invoices           Invoice[]
  payments           Payment[]
  quotations         Quotation[]
  subscriptions      Subscription[]
  User               User[]

  @@index([createdAt])
  @@index([status])
}

model Product {
  id                String             @id @default(cuid())
  name              String
  type              ProductType        @default(SOFTWARE)
  salesPrice        Decimal            @db.Decimal(10, 2)
  costPrice         Decimal            @db.Decimal(10, 2)
  notes             String?
  status            ProductStatus      @default(ACTIVE)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  variants          ProductVariant[]
  quotationLines    QuotationLine[]
  subscriptionLines SubscriptionLine[]

  @@index([createdAt])
  @@index([status])
  @@index([type])
}

model ProductVariant {
  id                String             @id @default(cuid())
  productId         String
  name              String
  sku               String
  priceAdjustment   Decimal            @default(0) @db.Decimal(10, 2)
  finalPrice        Decimal            @db.Decimal(10, 2)
  status            ProductStatus      @default(ACTIVE)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  product           Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  quotationLines    QuotationLine[]
  subscriptionLines SubscriptionLine[]

  @@index([productId])
  @@index([status])
}

model Plan {
  id              String          @id @default(cuid())
  name            String
  description     String
  price           Decimal         @db.Decimal(10, 2)
  billingInterval BillingInterval @default(MONTHLY)
  minQuantity     Int             @default(1)
  startDate       DateTime?
  endDate         DateTime?
  allowPause      Boolean         @default(true)
  allowEarlyClose Boolean         @default(true)
  allowRenewal    Boolean         @default(true)
  autoClose       Boolean         @default(false)
  status          ProductStatus   @default(ACTIVE)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  Quotation       Quotation[]
  subscriptions   Subscription[]

  @@index([billingInterval])
  @@index([createdAt])
  @@index([status])
}

model Quotation {
  id                      String          @id @default(cuid())
  quotationNumber         String          @unique
  customerId              String
  customerName            String
  templateName            String?
  validityDate            DateTime
  status                  QuotationStatus @default(DRAFT)
  subtotal                Decimal         @default(0) @db.Decimal(12, 2)
  taxTotal                Decimal         @default(0) @db.Decimal(12, 2)
  discountTotal           Decimal         @default(0) @db.Decimal(12, 2)
  totalAmount             Decimal         @default(0) @db.Decimal(12, 2)
  notes                   String?
  convertedSubscriptionId String?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  planId                  String?
  customer                Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  Plan                    Plan?           @relation(fields: [planId], references: [id])
  lines                   QuotationLine[]

  @@index([createdAt])
  @@index([customerId])
  @@index([planId])
  @@index([status])
  @@index([validityDate])
}

model QuotationLine {
  id             String          @id @default(cuid())
  quotationId    String
  productId      String?
  variantId      String?
  description    String
  quantity       Int             @default(1)
  unitPrice      Decimal         @db.Decimal(10, 2)
  taxRate        Decimal         @default(0) @db.Decimal(5, 2)
  discountAmount Decimal         @default(0) @db.Decimal(10, 2)
  lineTotal      Decimal         @db.Decimal(12, 2)
  product        Product?        @relation(fields: [productId], references: [id])
  quotation      Quotation       @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  variant        ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([productId])
  @@index([quotationId])
  @@index([variantId])
}

model Subscription {
  id                 String              @id @default(cuid())
  subscriptionNumber String              @unique
  customerId         String
  customerName       String
  planId             String
  planName           String
  billingInterval    BillingInterval     @default(MONTHLY)
  startDate          DateTime
  endDate            DateTime?
  nextBillingDate    DateTime
  paymentTerms       String              @default("Net 30")
  status             SubscriptionStatus  @default(ACTIVE)
  totalAmount        Decimal             @db.Decimal(12, 2)
  pauseDate          DateTime?
  resumeExpectedDate DateTime?
  closeReason        String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  invoices           Invoice[]
  customer           Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  plan               Plan                @relation(fields: [planId], references: [id])
  events             SubscriptionEvent[]
  lines              SubscriptionLine[]

  @@index([createdAt])
  @@index([customerId])
  @@index([nextBillingDate])
  @@index([planId])
  @@index([status])
}

model SubscriptionLine {
  id             String          @id @default(cuid())
  subscriptionId String
  productId      String?
  variantId      String?
  description    String
  quantity       Int             @default(1)
  unitPrice      Decimal         @db.Decimal(10, 2)
  taxRate        Decimal         @default(0) @db.Decimal(5, 2)
  discountAmount Decimal         @default(0) @db.Decimal(10, 2)
  lineTotal      Decimal         @db.Decimal(12, 2)
  product        Product?        @relation(fields: [productId], references: [id])
  subscription   Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  variant        ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([productId])
  @@index([subscriptionId])
  @@index([variantId])
}

model SubscriptionEvent {
  id             String       @id @default(cuid())
  subscriptionId String
  eventType      String
  timestamp      DateTime     @default(now())
  actor          String
  note           String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([timestamp])
}

model Invoice {
  id                 String              @id @default(cuid())
  invoiceNumber      String              @unique
  customerId         String
  customerName       String
  subscriptionId     String?
  subscriptionNumber String?
  issueDate          DateTime
  dueDate            DateTime
  status             InvoiceStatus       @default(DRAFT)
  currency           String              @default("USD")
  subtotal           Decimal             @db.Decimal(12, 2)
  taxAmount          Decimal             @db.Decimal(12, 2)
  discountAmount     Decimal             @db.Decimal(12, 2)
  totalAmount        Decimal             @db.Decimal(12, 2)
  amountPaid         Decimal             @default(0) @db.Decimal(12, 2)
  balanceDue         Decimal             @db.Decimal(12, 2)
  notes              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  customer           Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  subscription       Subscription?       @relation(fields: [subscriptionId], references: [id])
  lines              InvoiceLine[]
  allocations        PaymentAllocation[]

  @@index([createdAt])
  @@index([customerId])
  @@index([dueDate])
  @@index([status])
  @@index([subscriptionId])
}

model InvoiceLine {
  id             String  @id @default(cuid())
  invoiceId      String
  description    String
  quantity       Int     @default(1)
  unitPrice      Decimal @db.Decimal(10, 2)
  taxRate        Decimal @default(0) @db.Decimal(5, 2)
  discountAmount Decimal @default(0) @db.Decimal(10, 2)
  lineTotal      Decimal @db.Decimal(12, 2)
  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Payment {
  id            String              @id @default(cuid())
  paymentNumber String              @unique
  date          DateTime            @default(now())
  customerId    String
  customerName  String
  amount        Decimal             @db.Decimal(12, 2)
  method        PaymentMethod       @default(BANK_TRANSFER)
  reference     String
  status        PaymentStatus       @default(COMPLETED)
  notes         String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  customer      Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  allocations   PaymentAllocation[]

  @@index([createdAt])
  @@index([customerId])
  @@index([date])
  @@index([status])
}

model PaymentAllocation {
  id              String  @id @default(cuid())
  paymentId       String
  invoiceId       String
  invoiceNumber   String
  allocatedAmount Decimal @db.Decimal(12, 2)
  invoice         Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  payment         Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([paymentId])
}

model TaxRule {
  id            String    @id @default(cuid())
  name          String
  rate          Decimal   @db.Decimal(5, 2)
  applicability String    @default("ALL")
  effectiveFrom DateTime
  effectiveTo   DateTime?
  status        String    @default("ACTIVE")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([effectiveFrom, effectiveTo])
  @@index([status])
}

model Discount {
  id         String    @id @default(cuid())
  code       String    @unique
  name       String
  type       String    @default("PERCENTAGE")
  value      Decimal   @db.Decimal(10, 2)
  minAmount  Decimal   @default(0) @db.Decimal(10, 2)
  validFrom  DateTime
  validTo    DateTime?
  usageLimit Int       @default(100)
  usageCount Int       @default(0)
  scope      String    @default("ALL")
  status     String    @default("ACTIVE")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([status])
  @@index([validFrom, validTo])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actorName String
  action    String
  entity    String
  entityId  String
  details   String?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([createdAt])
  @@index([entity, entityId])
}

enum UserRole {
  ADMIN
  INTERNAL_STAFF
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum CustomerStatus {
  ACTIVE
  LEAD
  SUSPENDED
}

enum ProductType {
  SOFTWARE
  ADDON
  SERVICE
}

enum ProductStatus {
  ACTIVE
  ARCHIVED
}

enum BillingInterval {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  CONVERTED
}

enum SubscriptionStatus {
  DRAFT
  CONFIRMED
  ACTIVE
  PAUSED
  CLOSED
}

enum InvoiceStatus {
  DRAFT
  CONFIRMED
  PAID
  CANCELLED
  OVERDUE
}

enum PaymentMethod {
  BANK_TRANSFER
  CREDIT_CARD
  CASH
  CHECK
}

enum PaymentStatus {
  COMPLETED
  PENDING
  FAILED
}
